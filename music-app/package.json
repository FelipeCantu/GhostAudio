{
  "name": "dizc",
  "version": "0.1.0",
  "description": "DiZC - Your standalone high-fidelity music experience.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"NEXT,DJANGO\" -c \"magenta,blue\" \"next dev\" \"npm run django\"",
    "django": "cd ../backend && .\\venv\\Scripts\\python manage.py runserver",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ghostrepo.dizc",
    "productName": "DiZC",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-serve": "^1.1.0",
    "framer-motion": "^12.27.1",
    "lucide-react": "^0.563.0",
    "tailwind-merge": "^3.4.0"
  }
}