{
  "name": "dizc",
  "version": "0.2.0-beta",
  "description": "DiZC - High Fidelity Digital Music Library. Standalone, Cloud-Synced, Bit-Perfect.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"NEXT,DJANGO\" -c \"magenta,blue\" \"next dev\" \"npm run django\"",
    "django": "cd ../backend && .\\venv\\Scripts\\python manage.py runserver",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "cross-env ELECTRON_BUILD=true next build && electron-builder"
  },
  "build": {
    "appId": "com.ghostrepo.dizc",
    "productName": "DiZC",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist/ghost_backend.exe",
        "to": "ghost_backend.exe"
      },
      {
        "from": ".env.local",
        "to": ".env.local"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@splinetool/react-spline": "^4.1.0",
    "@types/three": "^0.182.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-serve": "^1.1.0",
    "framer-motion": "^12.27.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "mongoose": "^9.1.5",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0"
  }
}
